{
  "name": "gpt-sidekick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run",
    "evaluate": "node scripts/evaluate-outline.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
